# Copiar como ".env" y completar antes de levantar el docker-compose.
# El VPS solo necesita docker-compose.yml + este archivo.

# ── Base de datos ────────────────────────────────────────────
POSTGRES_USER=admin_user
POSTGRES_PASSWORD=CAMBIAR_ESTA_CONTRASENA
POSTGRES_DB=cuestionarios_db

# ── Aplicación ───────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# true solo si Postgres exige SSL (no es el caso de este docker-compose)
DB_SSL=false

# Se usa solo la primera vez que arranca, para crear el admin si la
# tabla está vacía. Cambia la contraseña desde el panel apenas entres.
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=CAMBIAR_ESTA_CONTRASENA_TAMBIEN

# ── Imagen publicada por GitHub Actions en GHCR ─────────────
# "latest" sigue main; o fija una versión, ej: v1.0.0
APP_TAG=latest
